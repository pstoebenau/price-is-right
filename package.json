{
	"name": "price-is-right",
	"version": "0.0.1",
	"devDependencies": {
		"@fontsource-variable/rubik": "^5.3.0",
		"@fontsource/bowlby-one": "^5.3.0",
		"@fontsource/doto": "^5.3.0",
		"@sveltejs/adapter-bun": "^1.0.3",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/bun": "^1.4.5",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"uqr": "^0.1.3",
		"vite": "^8.3.8"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"private": true,
	"scripts": {
		"dev": "bunx --bun vite dev --host",
		"build": "bunx --bun vite build",
		"preview": "bunx --bun vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && bunx --bun svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && bunx --bun svelte-check --tsconfig ./tsconfig.json --watch",
		"start": "bun server.ts",
		"test": "bun test server"
	},
	"type": "module"
}
