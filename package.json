{
	"name": "price-is-right",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"start": "node server.js",
		"test": "node --test server/*.test.js"
	},
	"devDependencies": {
		"@fontsource-variable/rubik": "^5.3.0",
		"@fontsource/bowlby-one": "^5.3.0",
		"@fontsource/doto": "^5.3.0",
		"@sveltejs/adapter-node": "^6.0.6",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"uqr": "^0.1.3",
		"vite": "^8.3.8"
	},
	"dependencies": {
		"ws": "^8.23.0"
	}
}
